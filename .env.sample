# Target Configuration
# Default points to local OWASP Juice Shop container on the compose network.
# Override TARGET_URL to scan your own deployed staging/preview environment.
TARGET_URL=http://juice-shop:3000
PLAN_FILE=plans/scan-juice-shop.yaml

# Authentication Configuration (Optional)
# For Juice Shop or JSON-auth APIs: entrypoint authenticates against AUTH_LOGIN_URL
# and injects Authorization: Bearer <token> via ZAP replacer rules.
AUTH_LOGIN_URL=http://juice-shop:3000/rest/user/login
AUTH_REGISTER_URL=http://juice-shop:3000/api/Users
AUTH_EMAIL=zap-scanner@example.com
AUTH_PASSWORD=ZapScanner!2026
AUTH_HEADER_NAME=Authorization
AUTH_TOKEN_PREFIX=Bearer
ZAP_AUTH_HEADER_VALUE=

# Scan Tuning
SPIDER_MAX_DURATION_MINS=2
AJAX_SPIDER_MAX_DURATION_MINS=2
ACTIVE_SCAN_POLICY=Default Policy
REPORT_DIR=/zap/wrk/reports
REPORT_NAME=zap-scan-report

# Alerting Configuration (Optional)
# Posts a summary payload ONLY when High/Critical findings > 0.
# Leave empty to disable webhook notifications.
WEBHOOK_URL=
ALERT_MIN_RISK=3
